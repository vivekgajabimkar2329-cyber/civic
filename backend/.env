# Backend-level .env (local development overrides)
# ─────────────────────────────────────────────────
# The main .env lives at civic/.env and is loaded by settings.py.
# Add local-only overrides here if needed.

# Local PostgreSQL (used only if DATABASE_URL is not set in civic/.env)
POSTGRES_DB=civic_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
